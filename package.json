{
  "name": "obsidian-fluency-bridge",
  "version": "0.2.0",
  "description": "In-flow contextual translation, false-friend & slang guard, and active vocabulary builder for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
