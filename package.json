    "obsidian-plugin",
    "translation",
    "fluency",
    "language-learning",
    "llm",
    "groq",
    "anki",
    "vocabulary"
  ],
  "author": "Yusuf Erkam Özyer",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.23.0",
    "obsidian": "latest",
    "tslib": "^2.6.3",
    "typescript": "^5.5.0"
  }
}
